# Copy to .env and fill in. Every variable is optional in development.

# --- Server ---
PORT=3000
# Public URL used in emails, Open Graph tags, sitemap.xml and Paymob callbacks
BASE_URL=http://localhost:3000
NODE_ENV=development
DATABASE_PATH=data/manhal.db
# Seed demo courses and accounts into an empty database (default: on outside production)
SEED_DEMO=true
LOG_LEVEL=info

# --- Email ---
# console (prints emails to the log, dev only) or resend
EMAIL_PROVIDER=console
EMAIL_FROM="Manhal <hello@example.com>"
RESEND_API_KEY=

# --- Payments ---
# demo (instant fake checkout, refused in production) or paymob
PAYMENTS_PROVIDER=demo
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Card integration ID(s), comma separated
PAYMOB_INTEGRATION_IDS=

# --- Protected video (optional) ---
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=
# Lifetime of signed video URLs, in seconds
VIDEO_URL_TTL=7200

# --- Backups ---
BACKUP_DIR=data/backups
BACKUP_KEEP=14

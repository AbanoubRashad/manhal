# Copy to .env and fill in. Every variable is optional in development.

# --- Server ---
PORT=3000
# Public URL used in emails, Open Graph tags, sitemap.xml and Paymob callbacks
BASE_URL=http://localhost:3000
NODE_ENV=development
DATABASE_PATH=data/manhal.db
# Seed demo courses and accounts into an empty database (default: on outside production)
SEED_DEMO=true
LOG_LEVEL=info

# --- Email ---
# console (prints emails to the log, dev only) or resend
EMAIL_PROVIDER=console
EMAIL_FROM="Manhal <hello@example.com>"
RESEND_API_KEY=

# --- Payments ---
# demo (instant fake checkout, refused in production) or paymob
PAYMENTS_PROVIDER=demo
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Card integration ID(s), comma separated
PAYMOB_INTEGRATION_IDS=

# --- Protected video (optional) ---
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=
# Lifetime of signed video URLs, in seconds
VIDEO_URL_TTL=7200

# --- Backups ---
BACKUP_DIR=data/backups
BACKUP_KEEP=14

# --- AI mentor (Nour) ---
# demo (canned replies built from lesson text, no key needed) or anthropic
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
# Tutoring uses the chat model; nudges, drafts and summaries use the fast model
AI_MODEL_CHAT=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-4-5-20251001
# USD per million tokens, for cost estimates. Check https://claude.com/pricing
AI_PRICE_CHAT_IN=2
AI_PRICE_CHAT_OUT=10
AI_PRICE_FAST_IN=1
AI_PRICE_FAST_OUT=5
# Messages per learner per day, and the monthly spending cap in USD
AI_DAILY_LIMIT_FREE=15
AI_DAILY_LIMIT_PLUS=100
AI_MONTHLY_BUDGET_USD=50
AI_MAX_INPUT_CHARS=1500
AI_MAX_OUTPUT_TOKENS=600
AI_RATE_PER_MINUTE=10
AI_TIMEOUT_MS=30000
# Chat history is deleted after this many days
AI_HISTORY_DAYS=90
# on = new learners are randomly split into "mentor" and "control" groups
AI_EXPERIMENT=off
# auto (SQLite FTS5 when available) or keyword
AI_SEARCH=auto

# --- Study coach ---
COACH_INACTIVE_DAYS=3
COACH_MIN_GAP_HOURS=48
COACH_MAX_PER_WEEK=3
# Quiet hours in each learner's own time zone (24-hour clock)
COACH_QUIET_START=22
COACH_QUIET_END=9

# Shown to a learner who seems to be in distress. Fill in VERIFIED Egyptian support
# contacts (name and number); leave empty to show only general guidance.
SUPPORT_RESOURCES_EG=
